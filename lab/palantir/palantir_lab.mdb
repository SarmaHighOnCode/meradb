-- ============================================================================
-- PALANTIR TECHNOLOGIES -- company database, built in MeraDB (Hinglish SQL)
-- Covers every SQL topic of the RDBMS Lab handout (CSC2131, Labs 1-12) and the
-- SQL / design / transaction topics of the Theory handout (CSC2103, L11-L46).
--
-- Every MeraDB (Hinglish) statement has the MySQL statement for the same job
-- written just above it, in a comment that starts with "-- MySQL:".
--
-- Run:      meradb_cli run lab\palantir\palantir_lab.mdb
-- Re-run:   meradb_cli run lab\palantir\palantir_reset.mdb   (wipes it first)
--
-- Lines marked "EXPECTED ERROR" fail ON PURPOSE: they prove that a constraint,
-- a foreign key, a trigger or a view really blocks bad data.
--
-- The company, products and cities are real public facts; every employee,
-- client, contract and number below is made-up sample data for the lab.
-- ============================================================================


-- ============================================================================
-- LAB 1 + THEORY L11-L13 : ER diagram -> relational model
-- ----------------------------------------------------------------------------
-- Entities      : Department, Employee, Product, Client, Contract, Project
-- Relationships :
--   Department 1 : N Employee            (FK employees.dept_id)
--   Employee   1 : N Employee (manages)  (FK employees.manager_id, SELF reference)
--   Client     M : N Product  via CONTRACT   (bridge table, 2 FKs)
--   Contract   1 : N Project             (FK projects.contract_id)
--   Employee   M : N Project  via ASSIGNMENT (bridge table, composite PK)
-- Every entity becomes a table, every attribute a column, every 1:N a foreign
-- key on the N side, every M:N a bridge table holding both primary keys.
-- ============================================================================


-- ============================================================================
-- LAB 2 + LAB 3 : DDL -- create the database, tables and data types
-- ============================================================================

-- MySQL: CREATE DATABASE palantir;
BANAO DATABASE palantir;

-- MySQL: USE palantir;
ISTEMAL palantir;

-- LAB 4 : CONSTRAINTS are declared inside CREATE TABLE
--   MUKHYA KUNJI = PRIMARY KEY   ZAROORI = NOT NULL   ANOKHA = UNIQUE
--   SANDARBH     = FOREIGN KEY   SHART   = CHECK      WARNA  = DEFAULT

-- MySQL: CREATE TABLE departments (
--          dept_id   INT PRIMARY KEY,
--          dept_name VARCHAR(40) NOT NULL UNIQUE,
--          location  VARCHAR(30) DEFAULT 'Denver',
--          budget_k  DECIMAL(10,2) CHECK (budget_k > 0)
--        );
BANAO TABLE departments (
    dept_id   INT          MUKHYA KUNJI,
    dept_name VARCHAR(40)  ZAROORI ANOKHA,
    location  VARCHAR(30)  WARNA 'Denver',
    budget_k  NUMBER(10,2) SHART (budget_k > 0)
);

-- MySQL: CREATE TABLE employees (
--          emp_id     INT PRIMARY KEY,
--          emp_name   VARCHAR(40) NOT NULL,
--          email      VARCHAR(60) UNIQUE,
--          job_title  VARCHAR(40),
--          dept_id    INT,
--          manager_id INT,
--          salary_k   DECIMAL(8,2) CHECK (salary_k > 0),
--          hire_date  DATE,
--          clearance  VARCHAR(10) DEFAULT 'NONE' CHECK (clearance IN ('NONE','SECRET','TOP SECRET')),
--          FOREIGN KEY (dept_id)    REFERENCES departments(dept_id),
--          FOREIGN KEY (manager_id) REFERENCES employees(emp_id)      -- self reference
--        );
BANAO TABLE employees (
    emp_id     INT          MUKHYA KUNJI,
    emp_name   VARCHAR(40)  ZAROORI,
    email      VARCHAR(60)  ANOKHA,
    job_title  VARCHAR(40),
    dept_id    INT          SANDARBH departments(dept_id),
    manager_id INT          SANDARBH employees(emp_id),
    salary_k   NUMBER(8,2)  SHART (salary_k > 0),
    hire_date  DATE,
    clearance  VARCHAR(10)  WARNA 'NONE' SHART (clearance MEIN ('NONE', 'SECRET', 'TOP SECRET'))
);

-- MySQL: CREATE TABLE products (
--          product_id   INT PRIMARY KEY,
--          product_name VARCHAR(30) NOT NULL UNIQUE,
--          launch_year  INT CHECK (launch_year BETWEEN 2003 AND 2030),
--          category     VARCHAR(30)
--        );
BANAO TABLE products (
    product_id   INT         MUKHYA KUNJI,
    product_name VARCHAR(30) ZAROORI ANOKHA,
    launch_year  INT         SHART (launch_year BEECH 2003 AUR 2030),
    category     VARCHAR(30)
);

-- MySQL: CREATE TABLE clients (
--          client_id   INT PRIMARY KEY,
--          client_name VARCHAR(40) NOT NULL UNIQUE,
--          sector      VARCHAR(30),
--          country     VARCHAR(30)
--        );
BANAO TABLE clients (
    client_id   INT         MUKHYA KUNJI,
    client_name VARCHAR(40) ZAROORI ANOKHA,
    sector      VARCHAR(30),
    country     VARCHAR(30)
);

-- Bridge table for Client M:N Product, with a composite UNIQUE key and a
-- CHECK that compares two columns of the same row.
-- MySQL: CREATE TABLE contracts (
--          contract_id INT PRIMARY KEY,
--          client_id   INT NOT NULL,
--          product_id  INT NOT NULL,
--          start_date  DATE NOT NULL,
--          end_date    DATE CHECK (end_date >= start_date),
--          value_musd  DECIMAL(8,2) CHECK (value_musd > 0),
--          status      VARCHAR(12) DEFAULT 'Active' CHECK (status IN ('Active','Completed','Cancelled')),
--          UNIQUE (client_id, product_id),
--          FOREIGN KEY (client_id)  REFERENCES clients(client_id),
--          FOREIGN KEY (product_id) REFERENCES products(product_id)
--        );
BANAO TABLE contracts (
    contract_id INT          MUKHYA KUNJI,
    client_id   INT          ZAROORI SANDARBH clients(client_id),
    product_id  INT          ZAROORI SANDARBH products(product_id),
    start_date  DATE         ZAROORI,
    end_date    DATE         SHART (end_date >= start_date),
    value_musd  NUMBER(8,2)  SHART (value_musd > 0),
    status      VARCHAR(12)  WARNA 'Active' SHART (status MEIN ('Active', 'Completed', 'Cancelled')),
    ANOKHA (client_id, product_id)
);

-- MySQL: CREATE TABLE projects (
--          project_id   INT PRIMARY KEY,
--          project_name VARCHAR(40) NOT NULL,
--          contract_id  INT,
--          lead_emp     INT,
--          budget_k     DECIMAL(10,2) CHECK (budget_k > 0),
--          FOREIGN KEY (contract_id) REFERENCES contracts(contract_id),
--          FOREIGN KEY (lead_emp)    REFERENCES employees(emp_id)
--        );
BANAO TABLE projects (
    project_id   INT          MUKHYA KUNJI,
    project_name VARCHAR(40)  ZAROORI,
    contract_id  INT          SANDARBH contracts(contract_id),
    lead_emp     INT          SANDARBH employees(emp_id),
    budget_k     NUMBER(10,2) SHART (budget_k > 0)
);

-- Bridge table for Employee M:N Project, with a COMPOSITE PRIMARY KEY.
-- MySQL: CREATE TABLE assignments (
--          emp_id     INT,
--          project_id INT,
--          role       VARCHAR(30),
--          hours      INT CHECK (hours >= 0),
--          PRIMARY KEY (emp_id, project_id),
--          FOREIGN KEY (emp_id)     REFERENCES employees(emp_id),
--          FOREIGN KEY (project_id) REFERENCES projects(project_id)
--        );
BANAO TABLE assignments (
    emp_id     INT          SANDARBH employees(emp_id),
    project_id INT          SANDARBH projects(project_id),
    role       VARCHAR(30),
    hours      INT          SHART (hours >= 0),
    MUKHYA KUNJI (emp_id, project_id)
);

-- Lookup table for the NON-EQUI join in Lab 8.
-- MySQL: CREATE TABLE salary_grades (grade CHAR(2) PRIMARY KEY, min_k INT, max_k INT);
BANAO TABLE salary_grades (
    grade CHAR(2) MUKHYA KUNJI,
    min_k INT,
    max_k INT
);

-- MySQL: SHOW TABLES;
DIKHAO TABLES;

-- MySQL: DESC employees;
BATAO employees;


-- ============================================================================
-- LAB 3 : MODIFYING A TABLE (ALTER / RENAME / TRUNCATE / DROP)
-- ============================================================================

-- MySQL: ALTER TABLE employees ADD phone VARCHAR(15);
SUDHARO TABLE employees JODO phone VARCHAR(15);

-- MySQL: ALTER TABLE employees ADD office VARCHAR(20) DEFAULT 'Denver';
SUDHARO TABLE employees JODO COLUMN office VARCHAR(20) WARNA 'Denver';

-- MySQL: ALTER TABLE employees RENAME COLUMN phone TO mobile;
SUDHARO TABLE employees COLUMN phone NAYA_NAAM mobile;

-- MySQL: ALTER TABLE employees DROP COLUMN mobile;
SUDHARO TABLE employees HATAO COLUMN mobile;

-- A scratch table to show rename, truncate and drop without touching real data.
-- MySQL: CREATE TABLE temp_notes (note_id INT PRIMARY KEY, note TEXT);
BANAO TABLE temp_notes (note_id INT MUKHYA KUNJI, note TEXT);

-- MySQL: INSERT INTO temp_notes VALUES (1, 'kickoff'), (2, 'review');
DAALO MEIN temp_notes MAAN (1, 'kickoff'), (2, 'review');

-- MySQL: RENAME TABLE temp_notes TO meeting_notes;     (or ALTER TABLE temp_notes RENAME TO meeting_notes;)
SUDHARO TABLE temp_notes NAYA_NAAM meeting_notes;

-- MySQL: TRUNCATE TABLE meeting_notes;      -- all rows gone, structure kept
SAAF TABLE meeting_notes;

-- MySQL: SELECT COUNT(*) FROM meeting_notes;
DIKHAO GINO(*) SE meeting_notes;

-- MySQL: DROP TABLE meeting_notes;          -- rows AND structure gone
HATAO TABLE meeting_notes;

-- MySQL: ALTER TABLE employees MODIFY job_title VARCHAR(60);
--   (No MeraDB command: a column's type cannot be changed in place.
--    The MeraDB way is ADD a new column, copy with UPDATE, DROP the old one.)


-- ============================================================================
-- LAB 5 : DML -- INSERT (named columns, all columns, multi-row, DEFAULT)
-- ============================================================================

-- MySQL: INSERT INTO departments (dept_id, dept_name, location, budget_k) VALUES
--          (10,'Engineering','Palo Alto',900), (20,'Forward Deployed Engineering','Denver',700),
--          (30,'Product','Palo Alto',400),     (40,'Sales and Partnerships','New York',350),
--          (50,'Legal and Compliance','Washington DC',150);
DAALO MEIN departments (dept_id, dept_name, location, budget_k) MAAN
    (10, 'Engineering',                  'Palo Alto',     900),
    (20, 'Forward Deployed Engineering', 'Denver',        700),
    (30, 'Product',                      'Palo Alto',     400),
    (40, 'Sales and Partnerships',       'New York',      350),
    (50, 'Legal and Compliance',         'Washington DC', 150);

-- DEFAULT value: location is left out, so it becomes 'Denver'.
-- MySQL: INSERT INTO departments (dept_id, dept_name, budget_k) VALUES (60, 'Research', 200);
DAALO MEIN departments (dept_id, dept_name, budget_k) MAAN (60, 'Research', 200);

-- Managers first (an employee's manager_id must already exist: foreign key).
-- MySQL: INSERT INTO employees (emp_id, emp_name, email, job_title, dept_id, manager_id, salary_k, hire_date, clearance)
--        VALUES (101,'Meera Iyer','meera.iyer@pltr.example','Chief Engineer',10,NULL,420,'2012-03-15','TOP SECRET');
DAALO MEIN employees (emp_id, emp_name, email, job_title, dept_id, manager_id, salary_k, hire_date, clearance) MAAN
    (101, 'Meera Iyer', 'meera.iyer@pltr.example', 'Chief Engineer', 10, KHALI, 420, '2012-03-15', 'TOP SECRET');

