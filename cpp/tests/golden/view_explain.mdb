BANAO TABLE courses (id INT MUKHYA KUNJI, title TEXT ANOKHA);
BANAO TABLE students (id INT MUKHYA KUNJI, naam TEXT, cgpa FLOAT, cid INT);
DAALO MEIN courses (id, title) MAAN (10, 'DBMS'), (20, 'OS');
DAALO MEIN students (id, naam, cgpa, cid) MAAN (1, 'Ravi', 8.4, 10), (2, 'Priya', 9.1, 10);
SAMJHAO DIKHAO * SE students;
SAMJHAO DIKHAO * SE students s;
SAMJHAO DIKHAO naam SE students JAHAN id = 1;
SAMJHAO DIKHAO naam SE students JAHAN id = 1 AUR cgpa > 5;
SAMJHAO DIKHAO naam SE students JAHAN 2 = id;
SAMJHAO DIKHAO naam SE students JAHAN id = '1';
SAMJHAO DIKHAO naam SE students JAHAN cgpa = 1;
SAMJHAO DIKHAO naam SE students JAHAN id > 1;
SAMJHAO DIKHAO naam SE students JAHAN id = 1 YA id = 2;
SAMJHAO DIKHAO title SE courses JAHAN title = 'OS';
SAMJHAO DIKHAO s.naam, c.title SE students s MILAO courses c PAR s.cid = c.id;
SAMJHAO DIKHAO s.naam, c.title SE students s BAAYAN MILAO courses c PAR s.cid = c.id;
SAMJHAO DIKHAO s.naam, c.title SE students s DAHINA MILAO courses c PAR s.cid = c.id;
SAMJHAO DIKHAO s.naam, c.title SE students s DONO MILAO courses c PAR s.cid = c.id;
SAMJHAO DIKHAO s.naam, c.title SE students s MILAO courses c PAR s.cid > c.id;
SAMJHAO DIKHAO * SE students SAMAAN MILAO courses;
SAMJHAO DIKHAO * SE students SAMAAN MILAO courses c;
SAMJHAO DIKHAO cid, GINO(*), KUL(cgpa) SE students SAMOOH cid JINKA GINO(*) > 1 KRAM cid ULTA SIRF 3;
SAMJHAO DIKHAO GINO(*) SE students;
SAMJHAO DIKHAO ALAG cid SE students KRAM naam, cgpa ULTA;
SAMJHAO DIKHAO naam KAHO n SE students KRAM n;
SAMJHAO DIKHAO naam SE students JAHAN cgpa > (DIKHAO AUSAT(cgpa) SE students);
SAMJHAO DIKHAO naam SE students s JAHAN cgpa = (DIKHAO ADHIKTAM(cgpa) SE students t JAHAN t.cid = s.cid);
SAMJHAO DIKHAO naam SE students JAHAN cid MEIN (DIKHAO id SE courses JAHAN id = 10);
SAMJHAO DIKHAO naam, (DIKHAO GINO(*) SE courses) SE students;
SAMJHAO DIKHAO id SE students SANYUKT DIKHAO id SE courses;
SAMJHAO DIKHAO id SE students JAHAN id = 1 SAAJHA DIKHAO id SE courses SANYUKT DIKHAO id SE courses JAHAN id = 10;
SAMJHAO BADLO students RAKHO cgpa = 1.0 JAHAN id = 1;
SAMJHAO BADLO students RAKHO cgpa = 1.0;
SAMJHAO MITAO SE students JAHAN id = 2 AUR cgpa > 1;
SAMJHAO MITAO SE students JAHAN cgpa > 1;
SAMJHAO MITAO SE students;
SAMJHAO DAALO MEIN students MAAN (9, 'x', 1.0, 10);
SAMJHAO BANAO TABLE q (a INT);
SAMJHAO BADLO nothing RAKHO a = 1;
SAMJHAO DIKHAO nope SE students;
BANAO VIEW v KAHO DIKHAO id, naam SE students;
SAMJHAO DIKHAO * SE v;
SAMJHAO DIKHAO * SE v JAHAN id = 1;
SAMJHAO BADLO v RAKHO id = 1;
SAMJHAO DIKHAO s.naam SE students s MILAO v x PAR s.id = x.id;
