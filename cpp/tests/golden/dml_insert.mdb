BANAO TABLE t (id INT MUKHYA KUNJI, naam TEXT ZAROORI);
DAALO MEIN t (id, naam) MAAN (1, 'a'), (2, 'b'), (3, KHALI);
DIKHAO * SE t;
DAALO MEIN t (id, naam) MAAN (1, 'a'), (2, 'b');
DAALO MEIN t (id, naam) MAAN (7, 'a'), (7, 'b');
DAALO MEIN t (id, id) MAAN (7, 8);
DAALO MEIN t (id, zz) MAAN (7, 8);
DAALO MEIN t (id, naam) MAAN (7);
DAALO MEIN t (id, naam) MAAN (10, 'x'), (11, 'y');
DAALO MEIN t MAAN (12, 'z');
DIKHAO * SE t;
BANAO TABLE u (k INT ANOKHA, v TEXT WARNA 'dflt', f FLOAT, d DATE, s VARCHAR(3), n INT SHART (n > 0));
DAALO MEIN u (k, s) MAAN (1, 'abcd');
DAALO MEIN u (k, n) MAAN (1, 0);
DAALO MEIN u (k, n) MAAN (1, KHALI);
DAALO MEIN u (k, f, d) MAAN (2, 3, '2024-01-05');
DAALO MEIN u (k) MAAN (2);
DAALO MEIN u (k, f) MAAN (5, 1.5), (6, 1.5);
DAALO MEIN u (k, v) MAAN (9, 5);
DIKHAO * SE u;
BANAO TABLE pairs (a INT, b INT, ANOKHA (a, b));
DAALO MEIN pairs MAAN (1, 2);
DAALO MEIN pairs MAAN (1, 2);
DAALO MEIN pairs MAAN (1, 3), (1, 3);
BANAO TABLE pf (a FLOAT ANOKHA);
DAALO MEIN pf MAAN (2.5);
DAALO MEIN pf MAAN (2.5);
BANAO TABLE pd (a DATE ANOKHA);
DAALO MEIN pd MAAN ('2024-03-09');
DAALO MEIN pd MAAN ('2024-03-09');
BANAO TABLE pt (a TEXT ANOKHA);
DAALO MEIN pt MAAN ('it''s');
DAALO MEIN pt MAAN ('it''s');
BANAO TABLE pb (a BOOL ANOKHA);
DAALO MEIN pb MAAN (SACH);
DAALO MEIN pb MAAN (SACH);
