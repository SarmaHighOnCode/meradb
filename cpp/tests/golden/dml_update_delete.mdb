BANAO TABLE p (id INT MUKHYA KUNJI, naam TEXT, score INT);
BANAO TABLE c (id INT MUKHYA KUNJI, pid INT SANDARBH p(id));
DAALO MEIN p MAAN (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);
DAALO MEIN c MAAN (100, 1), (101, 1), (102, KHALI);
DAALO MEIN c MAAN (103, 9);
DAALO MEIN p MAAN (1, 'dup', 0) TAKRAAV PAR BADLO naam = naam, score = score + 1;
DAALO MEIN p MAAN (1, 'dup', 5), (4, 'd', 40) TAKRAAV PAR BADLO naam = naam;
DIKHAO * SE p;
DAALO MEIN p MAAN (1, 'x', 0), (1, 'y', 0) TAKRAAV PAR BADLO naam = naam;
DAALO MEIN p MAAN (5, 'e', 50), (5, 'f', 50) TAKRAAV PAR BADLO naam = naam;
BADLO p RAKHO score = score + 5 JAHAN id = 2;
BADLO p RAKHO score = score + 1;
DIKHAO * SE p;
BADLO p RAKHO id = 1 JAHAN id = 2;
BADLO p RAKHO id = 50 JAHAN id = 1;
BADLO p RAKHO id = 50 JAHAN id = 3;
BADLO p RAKHO naam = 5 JAHAN id = 3;
BADLO p RAKHO nope = 5;
BADLO p RAKHO score = 1 JAHAN nope = 5;
BADLO p RAKHO id = id JAHAN id = 1;
BADLO c RAKHO pid = 77 JAHAN id = 100;
BADLO c RAKHO pid = 2 JAHAN id = 100;
MITAO SE p JAHAN id = 1;
MITAO SE p JAHAN id = 2;
MITAO SE p JAHAN id = 3;
MITAO SE c JAHAN id = 100;
MITAO SE c;
MITAO SE p JAHAN id = 1;
DIKHAO * SE p;
BANAO TABLE emp (id INT MUKHYA KUNJI, boss INT SANDARBH emp(id));
DAALO MEIN emp MAAN (1, KHALI), (2, 1), (3, 2);
DAALO MEIN emp MAAN (10, 11), (11, 10);
DAALO MEIN emp MAAN (20, 20);
DAALO MEIN emp MAAN (30, 99);
MITAO SE emp JAHAN id = 1;
MITAO SE emp JAHAN id = 2;
MITAO SE emp;
DIKHAO * SE emp;
DAALO MEIN nothing MAAN (1);
BANAO TABLE src (a INT, b TEXT);
DAALO MEIN src MAAN (1, 'q'), (2, 'r');
BANAO TABLE dst (a INT, b TEXT, z INT WARNA 7);
BANAO TABLE big (id INT MUKHYA KUNJI, w INT);
DAALO MEIN big MAAN (1, 1), (2, 2), (3, 3);
BADLO big RAKHO id = id + 1;
DIKHAO * SE big;
BADLO big RAKHO id = 1 JAHAN id = 2;
BANAO TABLE pairs (a INT, b INT, ANOKHA (a, b));
DAALO MEIN pairs MAAN (1, 2), (3, 4);
DAALO MEIN pairs MAAN (1, 2) TAKRAAV PAR BADLO b = 9;
DAALO MEIN pairs MAAN (1, 5) TAKRAAV PAR BADLO b = 9;
DIKHAO * SE pairs;
