BANAO TABLE courses (id INT MUKHYA KUNJI, title TEXT);
BANAO TABLE students (id INT MUKHYA KUNJI, naam TEXT, cgpa FLOAT, cid INT);
DAALO MEIN courses (id, title) MAAN (10, 'DBMS'), (20, 'OS'), (30, 'Networks');
DAALO MEIN students (id, naam, cgpa, cid) MAAN (1, 'Ravi', 8.4, 10), (2, 'Priya', 9.1, 10), (3, 'Aman', 7.0, KHALI), (4, 'Zoya', 6.5, 20);
DIKHAO naam SE students JAHAN cgpa > (DIKHAO AUSAT(cgpa) SE students);
DIKHAO naam SE students JAHAN cid MEIN (DIKHAO id SE courses JAHAN title JAISA '%S');
DIKHAO naam SE students JAHAN cid NAHI MEIN (DIKHAO id SE courses JAHAN title JAISA '%S') KRAM naam;
DIKHAO c.title SE courses c JAHAN (DIKHAO GINO(*) SE students s JAHAN s.cid = c.id) > 1;
DIKHAO title, (DIKHAO GINO(*) SE students s JAHAN s.cid = courses.id) KAHO n SE courses KRAM title;
DIKHAO title, (DIKHAO GINO(*) SE students s JAHAN s.cid = id) KAHO n SE courses;
DIKHAO c.title SE courses c JAHAN c.id MEIN (DIKHAO s.cid SE students s JAHAN s.cgpa > 8);
DIKHAO naam SE students s JAHAN cgpa = (DIKHAO ADHIKTAM(cgpa) SE students t JAHAN t.cid = s.cid);
DIKHAO naam SE students JAHAN cgpa > (DIKHAO cgpa SE students);
DIKHAO naam SE students JAHAN cgpa > (DIKHAO id, cgpa SE students SIRF 1);
DIKHAO naam SE students JAHAN cgpa > (DIKHAO cgpa SE students JAHAN id = 99);
DIKHAO naam SE students JAHAN cid MEIN (DIKHAO id, title SE courses);
DIKHAO naam SE students JAHAN id MEIN (DIKHAO nope SE courses);
DIKHAO naam SE students s JAHAN s.id = (DIKHAO GINO(*) SE courses c JAHAN c.id = z.q);
DIKHAO naam SE students JAHAN id = (DIKHAO GINO(*) SE courses c JAHAN c.id = zz);
DIKHAO s.naam SE students s MILAO courses c PAR s.cid = c.id JAHAN c.id = (DIKHAO ADHIKTAM(id) SE courses);
DIKHAO s.naam SE students s MILAO courses c PAR s.cid = c.id JAHAN (DIKHAO GINO(*) SE students t JAHAN id = 1) > 0;
DIKHAO naam SE students JAHAN cgpa > (DIKHAO AUSAT(cgpa) SE students) AUR cid MEIN (DIKHAO id SE courses) KRAM naam;
DIKHAO cid, GINO(*) SE students SAMOOH cid JINKA GINO(*) >= (DIKHAO GINO(*) SE courses JAHAN id = 10);
DIKHAO naam SE students KRAM (DIKHAO GINO(*) SE courses) ULTA, naam;
BADLO students RAKHO cgpa = (DIKHAO ADHIKTAM(cgpa) SE students) JAHAN id = 4;
DIKHAO id, cgpa SE students KRAM id;
MITAO SE students JAHAN cid MEIN (DIKHAO id SE courses JAHAN title = 'OS');
DIKHAO id SE students KRAM id;
MITAO SE students JAHAN cgpa < (DIKHAO AUSAT(cgpa) SE students);
DIKHAO id SE students KRAM id;
DAALO MEIN students (id, naam, cgpa) DIKHAO id + 10, title, 1.5 SE courses;
DIKHAO id, naam, cgpa SE students KRAM id;
