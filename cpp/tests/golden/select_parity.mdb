BANAO TABLE t (id INT MUKHYA KUNJI, a INT, b TEXT, f FLOAT);
DAALO MEIN t MAAN (1, 2, 'x', 1.5), (2, 1, 'y', 2.5), (3, 2, 'w', KHALI), (4, KHALI, 'z', 0.5), (5, 1, 'x', 2.5), (6, 3, '10%', 9.0);
BANAO TABLE u (k INT MUKHYA KUNJI, v INT);
DAALO MEIN u MAAN (1, 0), (2, 0);
BANAO TABLE n (x INT);
DAALO MEIN n MAAN (1), (KHALI);
BANAO TABLE d (id INT, day DATE, s TEXT);
DAALO MEIN d MAAN (1, '2024-02-29', '2024-02-29'), (2, '2024-03-01', 'abc');
DIKHAO id SE t JAHAN id NAHI MEIN (DIKHAO x SE n) KRAM id;
DIKHAO id SE t JAHAN id MEIN (DIKHAO x SE n) KRAM id;
DIKHAO id SE t JAHAN a NAHI MEIN (DIKHAO x SE n JAHAN x > 5) KRAM id;
DIKHAO id SE t JAHAN a MEIN (DIKHAO x SE n JAHAN x > 5) KRAM id;
DIKHAO id SE d JAHAN day MEIN (DIKHAO s SE d) KRAM id;
DIKHAO id SE d JAHAN s MEIN (DIKHAO day SE d) KRAM id;
DIKHAO id SE d JAHAN day < '2024-02-29 12:00:00' KRAM id;
DIKHAO id SE d JAHAN day = '2024-03-01 00:00:00';
DIKHAO id SE d JAHAN day < '2024-02-29 xx';
DAALO MEIN u MAAN (1, 5), (2, 6) TAKRAAV PAR BADLO k = 2;
DAALO MEIN u MAAN (1, 5), (1, 6) TAKRAAV PAR BADLO v = 7;
DIKHAO * SE u KRAM k;
DIKHAO a KAHO x, GINO(*) KAHO n SE t JAHAN a HAI NAHI KHALI SAMOOH x JINKA n > 1 KRAM x;
DIKHAO a + 1 KAHO a, GINO(*) SE t JAHAN a HAI NAHI KHALI SAMOOH a KRAM a ULTA;
DIKHAO id KAHO a SE t KRAM a ULTA SIRF 2;
DIKHAO a, id SE t KRAM 2 ULTA SIRF 2;
DIKHAO a, id SE t KRAM 1, 2 ULTA;
DIKHAO id SE t KRAM 2;
DIKHAO id SE t KRAM 1 + 1, id SIRF 1;
DIKHAO id SE t KRAM id SIRF 2 OFFSET 1;
DIKHAO id SE t KRAM id SIRF 1, 2;
DIKHAO id SE t KRAM id SIRF 99999999999 OFFSET 99999999999;
DIKHAO id SE t KRAM id SIRF 99999999999 OFFSET 4;
DIKHAO k SE u SANYUKT DIKHAO id SE t JAHAN id < 4 KRAM 1 ULTA SIRF 2;
DIKHAO k KAHO z SE u SANYUKT DIKHAO id SE t KRAM z ULTA SIRF 1, 2;
DIKHAO k SE u KRAM k ULTA SIRF 1 SANYUKT DIKHAO id SE t JAHAN id = 6;
DIKHAO k SE u SANYUKT DIKHAO id SE t KRAM nope;
DIKHAO k SE u SANYUKT ALL DIKHAO k SE u KRAM 1;
DIKHAO k SE u SANYUKT ALL DIKHAO k SE u SANYUKT DIKHAO k SE u KRAM 1;
DIKHAO k SE u SAAJHA ALL DIKHAO k SE u;
SAMJHAO DIKHAO k SE u SANYUKT ALL DIKHAO k SE u KRAM 1 SIRF 1 OFFSET 1;
DIKHAO GINO(ALAG a), KUL(ALAG a), AUSAT(ALAG a), GINO(a) SE t;
DIKHAO GINO(ALAG *) SE t;
DIKHAO b, GINO(distinct a) SE t SAMOOH b KRAM b;
DIKHAO KUL(a), KUL(ALAG a) SE t;
DIKHAO KUL((a + 1) * 2), KUL(a + 1 * 2) SE t;
DIKHAO KUL(AGAR a > 1 TAB 1 WARNA 0 KHATAM), KUL(AGAR a > 2 TAB 1 WARNA 0 KHATAM) SE t;
DIKHAO (a + 1) * 2, a + 1 * 2, a - (id - 1), (a - id) - 1, -(a + 1), NAHI (a = 1 YA id = 1), (a + 1) HAI KHALI SE t KRAM id SIRF 1;
DIKHAO a SE t SAMOOH a + 1;
DIKHAO a * 2 SE t SAMOOH a + 1;
DIKHAO a + 1, GINO(*) SE t SAMOOH a + 1 KRAM 2 ULTA, 1;
DIKHAO (a + 1) * 2, GINO(*) SE t SAMOOH a + 1 KRAM 2 ULTA, 1;
DIKHAO id SE t JAHAN 1;
DIKHAO id SE t JAHAN a;
DIKHAO id SE t JAHAN 'SACH';
DIKHAO id SE t JAHAN KHALI;
DIKHAO GINO(*) SE t JINKA 1;
DIKHAO AGAR 1 TAB 2 KHATAM SE t SIRF 1;
DIKHAO x.id SE t x MILAO t y PAR 1;
BADLO t RAKHO a = 2 JAHAN 1;
MITAO SE t JAHAN b;
DIKHAO 1 < 2 = SACH, 2 < 1 = SACH, 1 = 1 = SACH SE t SIRF 1;
DIKHAO 1 HAI KHALI = JHOOTH, 'a' JAISA 'a' = SACH, 2 BEECH 1 AUR 3 = SACH SE t SIRF 1;
DIKHAO 1 < 2 < 3 SE t SIRF 1;
DIKHAO b SE t JAHAN b JAISA '10!%' ESCAPE '!';
DIKHAO b SE t JAHAN b NAHI JAISA '1%' ESCAPE '!' KRAM id SIRF 1;
DIKHAO b JAISA '10!%' ESCAPE '!' SE t KRAM id SIRF 1;
DIKHAO KHALI JAISA 'a' ESCAPE '!', 'a' JAISA KHALI ESCAPE '!', 'a' JAISA 'a' ESCAPE KHALI SE t SIRF 1;
DIKHAO 'a' JAISA 'a' ESCAPE '!!' SE t SIRF 1;
DIKHAO 'a' JAISA 'a!' ESCAPE '!' SE t SIRF 1;
DIKHAO k, x SE u, n KRAM k, x;
DIKHAO p.k, q.x SE u p, n q JAHAN p.k = q.x;
DIKHAO id SE t JAHAN id MEIN (DIKHAO k SE u SANYUKT DIKHAO x SE n) KRAM id;
DIKHAO id SE t JAHAN id NAHI MEIN (DIKHAO k SE u JAHAN k = 1 SANYUKT DIKHAO id SE t JAHAN id = 2) KRAM id SIRF 2;
DIKHAO id SE t JAHAN id MEIN (DIKHAO k SE u SAAJHA DIKHAO id SE t JAHAN id = 2);
DIKHAO id SE t JAHAN id MEIN (DIKHAO k SE u CHHODKAR DIKHAO id SE t JAHAN id = 2);
DIKHAO id, (DIKHAO k SE u JAHAN k = t.id SANYUKT DIKHAO id SE t JAHAN id = 9 KRAM 1 SIRF 1) SE t KRAM id SIRF 3;
DIKHAO id SE t JAHAN id MEIN (DIKHAO k SE u JAHAN k = t.id SANYUKT DIKHAO x SE n JAHAN x = t.id) KRAM id;
SAMJHAO DIKHAO id SE t JAHAN id MEIN (DIKHAO k SE u SANYUKT DIKHAO x SE n);
DIKHAO 1e2 + 1, 2.5E-1, 1E+2, -1e2 SE t SIRF 1;
DIKHAO 1e999 SE t;
DIKHAO 1e308 * 10 SE t SIRF 1;
DIKHAO 1e308 + 1e308 SE t SIRF 1;
DIKHAO 1e308 / 0.1 SE t SIRF 1;
