BANAO TABLE a (id INT, n TEXT);
BANAO TABLE b (id INT, n TEXT);
DAALO MEIN a MAAN (1, 'x'), (2, 'y'), (2, 'y'), (3, KHALI);
DAALO MEIN b MAAN (2, 'y'), (3, KHALI), (4, 'z');
DIKHAO id SE a SANYUKT DIKHAO id SE b;
DIKHAO id, n SE a SANYUKT DIKHAO id, n SE b;
DIKHAO id, n SE a SAAJHA DIKHAO id, n SE b;
DIKHAO id, n SE a CHHODKAR DIKHAO id, n SE b;
DIKHAO id, n SE b CHHODKAR DIKHAO id, n SE a;
DIKHAO id SE a SANYUKT DIKHAO id SE b SAAJHA DIKHAO id SE a;
DIKHAO id SE a SANYUKT DIKHAO id, n SE b;
DIKHAO id KAHO first SE a SANYUKT DIKHAO id KAHO second SE b;
DIKHAO id SE a JAHAN id > 1 SANYUKT DIKHAO id SE b JAHAN id < 4;
DIKHAO id SE a KRAM id ULTA SANYUKT DIKHAO id SE b;
BANAO TABLE f (v FLOAT);
BANAO TABLE i (v INT);
DAALO MEIN f MAAN (1.0), (2.5);
DAALO MEIN i MAAN (1), (2);
DIKHAO v SE f SANYUKT DIKHAO v SE i;
DIKHAO v SE i SAAJHA DIKHAO v SE f;
DIKHAO v SE i CHHODKAR DIKHAO v SE f;
