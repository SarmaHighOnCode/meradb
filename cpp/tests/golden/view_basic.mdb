BANAO TABLE courses (id INT MUKHYA KUNJI, title TEXT);
BANAO TABLE students (id INT MUKHYA KUNJI, naam TEXT, cgpa FLOAT, cid INT, joined DATE);
DAALO MEIN courses (id, title) MAAN (10, 'DBMS'), (20, 'OS');
DAALO MEIN students (id, naam, cgpa, cid, joined) MAAN (1, 'Ravi', 8.4, 10, '2023-07-01'), (2, 'Priya', 9.1, 10, KHALI), (3, 'Aman', 7.0, KHALI, '2024-01-20');
BANAO VIEW topper KAHO DIKHAO naam, cgpa;
BANAO VIEW topper KAHO DIKHAO naam, cgpa SE students JAHAN cgpa > 8;
BANAO VIEW topper KAHO DIKHAO naam, cgpa SE students JAHAN cgpa > 8;
BANAO VIEW students KAHO DIKHAO id SE courses;
BANAO TABLE topper (a INT);
BANAO VIEW bad KAHO DIKHAO nope SE students;
BANAO VIEW bad KAHO DIKHAO id SE nothing;
DIKHAO VIEWS;
DIKHAO TABLES;
BATAO topper;
BATAO nothing;
DIKHAO * SE topper;
DIKHAO naam SE topper JAHAN cgpa > 9;
DIKHAO naam SE topper KRAM cgpa;
DIKHAO GINO(*), AUSAT(cgpa) SE topper;
DIKHAO t.naam, c.title SE topper t MILAO courses c PAR c.id = 10;
DIKHAO s.naam, t.cgpa SE students s MILAO topper t PAR s.naam = t.naam KRAM s.naam;
BANAO VIEW joined_v KAHO DIKHAO s.naam KAHO who, c.title SE students s BAAYAN MILAO courses c PAR s.cid = c.id;
DIKHAO * SE joined_v KRAM who;
BANAO VIEW dates KAHO DIKHAO id, joined, cgpa > 8 KAHO high, cgpa * 2 SE students;
BATAO dates;
DIKHAO * SE dates KRAM id;
DIKHAO id SE dates JAHAN joined > '2023-01-01';
BANAO VIEW empty_v KAHO DIKHAO id, naam SE students JAHAN id > 100;
DIKHAO * SE empty_v;
BANAO VIEW nested KAHO DIKHAO naam SE topper;
DIKHAO * SE nested;
DIKHAO naam SE students JAHAN naam MEIN (DIKHAO naam SE topper) KRAM naam;
DIKHAO ALAG cid SE students;
DAALO MEIN topper MAAN ('z', 1.0);
BADLO topper RAKHO naam = 'z';
MITAO SE topper;
HATAO TABLE topper;
BADLO students RAKHO cgpa = 1.0 JAHAN id = 1;
DIKHAO * SE topper;
SUDHARO TABLE students HATAO COLUMN cgpa;
DIKHAO * SE topper;
HATAO VIEW topper;
HATAO VIEW topper;
DIKHAO VIEWS;
DIKHAO * SE topper;
