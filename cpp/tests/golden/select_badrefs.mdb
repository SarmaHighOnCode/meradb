BANAO TABLE s (id INT, n TEXT);
BANAO TABLE t (id INT, m TEXT);
DAALO MEIN s MAAN (1, 'a'), (2, 'b');
DAALO MEIN t MAAN (1, 'x');
DIKHAO * SE s JAHAN n1 = n2;
DIKHAO * SE s JAHAN n1 + n2 > 1 AUR n3 = 1;
DIKHAO * SE s JAHAN n1 = 1 AUR n2 = 2;
DIKHAO * SE s JAHAN n1 BEECH n2 AUR n3;
DIKHAO * SE s JAHAN n1 MEIN (n2, n3);
DIKHAO * SE s JAHAN n1 JAISA n2;
DIKHAO n1 + n2 SE s;
DIKHAO AGAR n1 = 1 TAB n2 WARNA n3 KHATAM SE s;
DIKHAO AGAR id = 1 TAB n2 WARNA n3 KHATAM SE s;
DIKHAO AGAR id = 1 TAB 1 AGAR n1 = 1 TAB n2 KHATAM SE s;
DIKHAO id SE s KRAM n1, n2;
DIKHAO id SE s SAMOOH n1, n2;
DIKHAO * SE s a MILAO t b PAR a.n1 = b.n2;
DIKHAO * SE s a MILAO t b PAR a.id = b.n2 AUR a.n1 = b.id;
DIKHAO * SE s JAHAN s.q1 = s.q2;
DIKHAO * SE s JAHAN z.q1 = y.q2;
DIKHAO id SE s a JAHAN id = (DIKHAO id SE t b JAHAN z1 = z2);
DIKHAO id SE s a JAHAN id = (DIKHAO id SE t b JAHAN z1 + z2 > 1);
DIKHAO id SE s a JAHAN id = (DIKHAO id SE t b JAHAN z1 BEECH z2 AUR z3);
DIKHAO id SE s a JAHAN id = (DIKHAO id SE t b JAHAN z1 MEIN (z2, z3));
DIKHAO id SE s a JAHAN id = (DIKHAO id SE t b JAHAN AGAR z1 = 1 TAB z2 WARNA z3 KHATAM);
DIKHAO id SE s a JAHAN id = (DIKHAO b.id SE t b MILAO t c PAR z1 = z2);
BANAO VIEW v1 KAHO DIKHAO id SE s;
BANAO VIEW v4 KAHO DIKHAO id SE t;
DIKHAO * SE v1 MILAO v4 PAR v1.naam = v4.naam;
SAMJHAO DIKHAO * SE s JAHAN n1 = n2;
BADLO s RAKHO n = 'q' JAHAN n1 = n2;
MITAO SE s JAHAN n1 = n2;
BADLO s RAKHO n = n1 + n2;
