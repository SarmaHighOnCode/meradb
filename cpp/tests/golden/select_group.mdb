BANAO TABLE sales (id INT MUKHYA KUNJI, region TEXT, product TEXT, qty INT, price FLOAT);
DAALO MEIN sales MAAN (1, 'N', 'a', 5, 2.5), (2, 'N', 'b', 3, 4.0), (3, 'S', 'a', 7, 2.5), (4, 'S', 'a', KHALI, 2.5), (5, 'E', 'b', 1, KHALI), (6, KHALI, 'a', 2, 1.0);
DIKHAO GINO(*) SE sales;
DIKHAO GINO(qty), KUL(qty), AUSAT(qty), NYUNTAM(qty), ADHIKTAM(qty) SE sales;
DIKHAO region, GINO(*) SE sales SAMOOH region;
DIKHAO region, GINO(*) KAHO total SE sales SAMOOH region JINKA GINO(*) > 1;
DIKHAO region, KUL(qty * price) KAHO rev SE sales SAMOOH region KRAM rev ULTA;
DIKHAO region, product, GINO(*) SE sales SAMOOH region, product KRAM region, product;
DIKHAO product, AUSAT(price) SE sales SAMOOH product;
DIKHAO region SE sales SAMOOH region JINKA KUL(qty) > 5;
DIKHAO GINO(*) SE sales JAHAN id > 100;
DIKHAO KUL(qty), AUSAT(qty), NYUNTAM(qty) SE sales JAHAN id > 100;
DIKHAO region, GINO(*) SE sales JAHAN id > 100 SAMOOH region;
DIKHAO GINO(*) SE sales JINKA GINO(*) > 3;
DIKHAO GINO(*) SE sales JINKA GINO(*) > 30;
DIKHAO region, qty SE sales SAMOOH region;
DIKHAO naam, GINO(*) SE sales SAMOOH naam;
DIKHAO region, GINO(*) SE sales KRAM qty SAMOOH region;
DIKHAO KUL(KUL(qty)) SE sales;
DIKHAO GINO(*) + 1 KAHO n SE sales;
DIKHAO region, GINO(*) SE sales SAMOOH region KRAM GINO(*) ULTA, region;
DIKHAO region SE sales SAMOOH region KRAM ADHIKTAM(qty) ULTA;
DIKHAO ALAG region SE sales;
DIKHAO ALAG GINO(*) SE sales SAMOOH region;
DIKHAO region, GINO(*) SE sales SAMOOH region SIRF 2;
DIKHAO KUL(product) SE sales;
DIKHAO NYUNTAM(product), ADHIKTAM(region) SE sales;
DIKHAO KUL(*) SE sales;
DIKHAO FOO(qty) SE sales;
DIKHAO GINO(*) SE sales JAHAN GINO(*) > 1;
DIKHAO region SE sales SAMOOH GINO(*);
DIKHAO qty > 2, GINO(*) SE sales SAMOOH qty > 2 KRAM qty > 2;
DIKHAO s.region, GINO(*) SE sales s SAMOOH s.region KRAM s.region;
DIKHAO region, AGAR GINO(*) > 1 TAB 'many' WARNA 'one' KHATAM KAHO k SE sales SAMOOH region KRAM region;
DIKHAO region, PEHLA(AUSAT(qty), -1) SE sales SAMOOH region KRAM region;
