BANAO TABLE courses (id INT MUKHYA KUNJI, title TEXT ANOKHA);
BANAO TABLE students (id INT MUKHYA KUNJI, naam TEXT, cid INT);
BANAO TABLE marks (sid INT, cid INT, score INT);
DAALO MEIN courses (id, title) MAAN (10, 'DBMS'), (20, 'OS'), (30, 'Networks');
DAALO MEIN students (id, naam, cid) MAAN (1, 'Ravi', 10), (2, 'Priya', 10), (3, 'Aman', KHALI), (4, 'Zoya', 40);
DAALO MEIN marks MAAN (1, 10, 80), (1, 20, 70), (2, 10, 95), (9, 10, 50), (2, KHALI, 60);
DIKHAO s.naam, c.title SE students s MILAO courses c PAR s.cid = c.id;
DIKHAO s.naam, c.title SE students s BAAYAN MILAO courses c PAR s.cid = c.id;
DIKHAO s.naam, c.title SE students s DAHINA MILAO courses c PAR s.cid = c.id;
DIKHAO s.naam, c.title SE students s DONO MILAO courses c PAR s.cid = c.id;
DIKHAO s.naam, c.title SE students s BAAYAN MILAO courses c PAR s.cid = c.id JAHAN s.naam = 'Aman';
DIKHAO s.naam, c.title SE students s BAAYAN MILAO courses c PAR s.cid = c.id JAHAN c.title HAI KHALI;
DIKHAO * SE students s MILAO courses c PAR s.cid = c.id;
DIKHAO * SE students SAMAAN MILAO courses;
DIKHAO * SE students s SAMAAN MILAO marks m;
DIKHAO s.naam, m.score SE students s MILAO marks m PAR s.id = m.sid KRAM s.naam, m.score;
DIKHAO s.naam, m.score SE students s MILAO marks m PAR s.id = m.sid AUR m.score > 75;
DIKHAO s.naam, m.score SE students s BAAYAN MILAO marks m PAR s.id = m.sid AUR m.score > 75 KRAM s.naam;
DIKHAO s.naam, m.score SE students s DAHINA MILAO marks m PAR s.id = m.sid KRAM m.score;
DIKHAO s.naam, m.score SE students s DONO MILAO marks m PAR s.id = m.sid;
DIKHAO s.naam, c.title SE students s MILAO courses c PAR s.cid > c.id KRAM s.naam, c.title;
DIKHAO s.naam, c.title SE students s MILAO courses c PAR s.cid < c.id AUR c.id < 30 KRAM s.naam;
DIKHAO s.naam, c.title SE students s DAHINA MILAO courses c PAR s.cid < c.id;
DIKHAO s.naam, c.title SE students s DONO MILAO courses c PAR s.cid < c.id;
DIKHAO a.naam, b.naam SE students a MILAO students b PAR a.cid = b.cid AUR a.id < b.id;
DIKHAO naam, title SE students MILAO courses PAR cid = courses.id;
DIKHAO id SE students MILAO courses PAR students.cid = courses.id;
DIKHAO s.naam, c.title, m.score SE students s MILAO marks m PAR s.id = m.sid MILAO courses c PAR m.cid = c.id KRAM s.naam, c.title;
DIKHAO s.naam SE students s MILAO courses c PAR c.id = m.cid MILAO marks m PAR m.sid = s.id;
DIKHAO * SE students MILAO students PAR students.id = students.id;
DIKHAO a.id SE students a MILAO courses a PAR a.id = a.id;
DIKHAO s.naam SE students s MILAO courses c PAR s.zzz = c.id;
DIKHAO cid SE students s MILAO marks m PAR s.id = m.sid;
DIKHAO * SE students SAMAAN MILAO nothing;
DIKHAO c.title, GINO(*) SE courses c BAAYAN MILAO students s PAR s.cid = c.id SAMOOH c.title KRAM c.title;
