BANAO TABLE courses (id INT MUKHYA KUNJI, title TEXT ANOKHA);
BANAO TABLE students (id INT MUKHYA KUNJI, naam TEXT, cgpa FLOAT, cid INT SANDARBH courses(id), joined DATE, active BOOL WARNA SACH);
DAALO MEIN courses (id, title) MAAN (10, 'DBMS'), (20, 'OS'), (30, 'Networks');
DAALO MEIN students (id, naam, cgpa, cid, joined) MAAN (1, 'Ravi', 8.4, 10, '2023-07-01'), (2, 'Priya', 9.1, 10, '2022-08-15'), (3, 'Aman', 7.0, KHALI, '2024-01-20'), (4, 'Zoya', 9.1, 20, KHALI), (5, 'ravi', KHALI, 20, '2023-07-01');
DIKHAO * SE students;
DIKHAO naam SE students JAHAN cgpa > 8 KRAM cgpa ULTA SIRF 1;
DIKHAO naam, cgpa SE students KRAM cgpa;
DIKHAO naam, cgpa SE students KRAM cgpa ULTA, naam;
DIKHAO naam, cgpa SE students KRAM cgpa SEEDHA, naam ULTA;
DIKHAO ALAG cgpa SE students;
DIKHAO ALAG cid SE students KRAM cid;
DIKHAO naam KAHO n, cgpa * 2 KAHO double SE students KRAM double ULTA, n;
DIKHAO naam, cgpa + 1, cgpa / 2, id % 2, -id SE students;
DIKHAO id, naam SE students JAHAN id = 3;
DIKHAO id, naam SE students JAHAN id = 3 AUR naam = 'Aman';
DIKHAO id SE students JAHAN id = 99;
DIKHAO id SE students JAHAN id = '3';
DIKHAO id SE students JAHAN naam JAISA 'r%';
DIKHAO id SE students JAHAN naam JAISA '%a%' KRAM id;
DIKHAO id SE students JAHAN cgpa BEECH 7 AUR 8.5;
DIKHAO id SE students JAHAN cid MEIN (10, 30);
DIKHAO id SE students JAHAN cid NAHI MEIN (10, 30);
DIKHAO id SE students JAHAN cgpa HAI KHALI;
DIKHAO id SE students JAHAN cid HAI NAHI KHALI KRAM id ULTA;
DIKHAO id, joined SE students KRAM joined, id;
DIKHAO id SE students JAHAN joined > '2023-01-01';
DIKHAO id, PEHLA(cgpa, 0.0) SE students;
DIKHAO id, AGAR cgpa > 9 TAB 'top' AGAR cgpa > 8 TAB 'good' WARNA 'ok' KHATAM KAHO band SE students KRAM id;
DIKHAO id SE students SIRF 0;
DIKHAO id SE students SIRF 2;
DIKHAO s.id, s.naam SE students s JAHAN s.id < 3;
DIKHAO students.id SE students;
DIKHAO nope SE students;
DIKHAO id SE nothing;
DIKHAO id SE students JAHAN nope = 1;
DIKHAO id SE students KRAM nope;
DIKHAO id + naam SE students;
DIKHAO id SE students JAHAN naam + 1 > 2;
DIKHAO id SE students JAHAN active;
DIKHAO id, active SE students JAHAN NAHI active;
DIKHAO id SE students JAHAN id > 1 YA id < 0 KRAM id ULTA;
DIKHAO 1 + 2, 'x' SE students SIRF 1;
DIKHAO cgpa / 0 SE students;
DIKHAO id % 0 SE students;
DIKHAO naam SE students KRAM naam;
DIKHAO naam KAHO n SE students KRAM n;
DIKHAO naam KAHO id SE students KRAM id ULTA;
DIKHAO * SE courses KRAM title ULTA;
DIKHAO id, id SE courses;
