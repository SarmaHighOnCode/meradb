// meradb_gui.rc.in -- the Windows resources of meradb_gui: the application icon and the version information.
// CMake fills in @MERADB_GUI_ICON_PATH@ and writes meradb_gui.rc into the build folder.
#include <winver.h>

1 ICON "@MERADB_GUI_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MeraDB Workbench"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "meradb_gui"
            VALUE "OriginalFilename", "meradb_gui.exe"
            VALUE "ProductName", "MeraDB Workbench"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
